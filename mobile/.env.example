# Copy this file to .env to override which backend the app talks to.
# Not required for normal use - without a .env file, the app already
# points at the production MarketplaceAlert backend (see src/api/config.ts).
#
# Expo automatically inlines any env var prefixed EXPO_PUBLIC_ into the
# JS bundle at build/start time - see
# https://docs.expo.dev/guides/environment-variables/
# Never put a secret in an EXPO_PUBLIC_ variable - it ships inside the app.

# Production (default if unset):
EXPO_PUBLIC_API_BASE_URL=https://marketplacealert.onrender.com

# Local backend development (uncomment and adjust - see the main repo's
# README.md "Running the app" for starting the backend locally):
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

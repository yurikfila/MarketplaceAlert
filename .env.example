# Copy this file to .env and fill in real values. Never commit .env itself.

APP_NAME="Marketplace Alert"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local persistence and duplicate detection (Phase 3), PostgreSQL support
# in production (Phase 8). Leave unset for local SQLite development - the
# app falls back to sqlite:///./marketplace_alert.db unchanged. Set to a
# real PostgreSQL URL only in production (e.g. Render's managed Postgres -
# both the postgres:// and postgresql:// forms it may issue are normalized
# automatically, see core/persistence/database.py). Never put a real
# connection string/password here.
DATABASE_URL=

# Telegram notifications for newly discovered listings (Phase 4).
# Leave both unset to disable notifications - the app still starts normally.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Robust Telegram delivery under bursts (many new listings in one scan) -
# a pacing delay between sends, plus bounded retries with backoff for
# transient failures (429/5xx/timeouts). Safe defaults are used if these
# are left unset - only override if Telegram's real-world limits change.
TELEGRAM_SEND_DELAY_SECONDS=1.0
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BASE_SECONDS=2.0

# Etsy Open API v3 (Phase 2). Both are required - Etsy's x-api-key header
# is "<ETSY_API_KEY>:<ETSY_SHARED_SECRET>", not the API key alone. Leave
# both unset to disable the Etsy connector - the app still starts normally.
ETSY_API_KEY=your-etsy-keystring
ETSY_SHARED_SECRET=your-etsy-shared-secret

# eBay Buy Browse API (Phase 2). EBAY_APP_ID/EBAY_CERT_ID are used as the
# OAuth client_credentials client_id/client_secret. EBAY_DEV_ID is not read
# by this app - the Browse API's application token flow doesn't need it.
# Leave EBAY_APP_ID/EBAY_CERT_ID unset to disable the eBay connector - the
# app still starts normally.
EBAY_APP_ID=your-ebay-app-id
EBAY_DEV_ID=your-ebay-dev-id
EBAY_CERT_ID=your-ebay-cert-id

# Reverb API v3 (musical instruments/gear marketplace). A single personal
# access token (created with at least the "public" scope), sent as
# Authorization: Bearer <token> - not a client id/secret pair. Leave unset
# to disable the Reverb connector - the app still starts normally.
REVERB_API_TOKEN=

# Bonanza's "Bonapitit" API (general/eBay-like marketplace). A single
# developer name, obtained by registering a free developer account at
# https://api.bonanza.com/accounts/new - not a secret token. Leave unset
# to disable the Bonanza connector - the app still starts normally.
BONANZA_DEV_NAME=

# CORS for future web/dev tooling (Phase 9 mobile-API prep - see
# PROJECT_CONTEXT.md/ARCHITECTURE.md "Mobile API"). Native mobile apps
# don't need browser CORS at all; this only matters for a future
# browser-based client (e.g. an Expo/React Native web preview) calling
# this API cross-origin. Comma-separated list of allowed origins, e.g.
# "http://localhost:3000,https://app.example.com". Leave unset/empty to
# disable cross-origin browser access entirely (safe default) - never set
# this to "*" in production.
CORS_ALLOWED_ORIGINS=

# Authentication - signs/verifies JWT access tokens. Leave unset for local
# SQLite development and the test suite: a temporary, process-local secret
# is generated automatically (sessions just don't survive a restart - fine
# for local dev). REQUIRED whenever DATABASE_URL is set (i.e. any real
# deployment, including production) - the app refuses to start without a
# real value there, on purpose; there is no insecure default. Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never commit a real value, and never reuse this example/a short/guessable
# one anywhere real.
JWT_SECRET_KEY=

# Token lifetimes - safe defaults, only override if you have a specific
# reason to. See config.py for the full reasoning behind each.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Brute-force login protection - safe defaults, only override if you have a
# specific reason to. See config.py for the full reasoning.
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15.0

# Marketplace connector credentials go here as connectors are added.
